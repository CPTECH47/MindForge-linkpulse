# Copy to .env for Docker Compose. Direct Python commands use exported shell variables.
DEBUG=true
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
POSTGRES_PASSWORD=local-development-change-me
# For Python with a local PostgreSQL service:
# DATABASE_URL=postgresql://linkpulse:your-password@127.0.0.1:5432/linkpulse
TRUST_PROXY=false
TRUST_PROXY_IP=false
CREATE_RATE_LIMIT=100
PASSWORD_RATE_LIMIT=10
EVENT_RETENTION_DAYS=30
# Optional override. Default: data/geoip-country.mmdb, installed with manage.py install_geoip.
GEOIP_DATABASE=
